+void EBIndexSpace::reportLayoutCache(std::ostream& a_os, const char* a_prefix) const
+{
+  int totalSize   = 0;
+  int totalPinned = 0;
+
+  for (int ilev = 0; ilev < m_nlevels; ilev++)
+    {
+      if (m_ebisLevel[ilev] == NULL) continue;
+
+      const int size   = m_ebisLevel[ilev]->getCacheSize();
+      const int pinned = m_ebisLevel[ilev]->getCachePinned();
+
+      totalSize   += size;
+      totalPinned += pinned;
+
+      a_os << a_prefix << " EBISLayout cache, level " << ilev
+           << ": entries = "  << size
+           << " pinned = "    << pinned
+           << " hits = "      << m_ebisLevel[ilev]->getCacheHits()
+           << " misses = "    << m_ebisLevel[ilev]->getCacheMisses() << "\n";
+    }
+
+  a_os << a_prefix << " EBISLayout cache, all levels: entries = " << totalSize
+       << " pinned = " << totalPinned << "\n";
+}
