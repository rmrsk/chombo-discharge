+int EBISLevel::getCachePinned() const
+{
+  int pinned = 0;
+
+  dmap::const_iterator d = m_cache.begin();
+  while (d != m_cache.end())
+    {
+      // refreshCache() evicts at refcount one, so anything above that is held elsewhere.
+      if(d->second.refCount() > 1)
+        {
+          pinned++;
+        }
+      d++;
+    }
+
+  return pinned;
+}
